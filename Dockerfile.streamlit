# Streamlit front end for ppt2word. Microsoft Office is not required here;
# users provide PDFs exported on their own Office-capable environment.
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/tmp \
    PPT2WORD_TEMPLATES_DIR=/templates

RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir "pip>=26.2" \
    && python -m pip install --no-cache-dir \
        "lxml>=6.1.1" \
        "pdf2image>=1.17.0" \
        "Pillow>=12.3.0" \
        "python-docx>=1.2.0" \
        "python-pptx>=1.0.2" \
        "streamlit>=1.50.0"

WORKDIR /opt/ppt2word

RUN mkdir -p /templates

COPY ppt2word.py app.py ./

EXPOSE 8501

ENTRYPOINT ["streamlit", "run", "/opt/ppt2word/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.fileWatcherType=none", "--browser.gatherUsageStats=false"]
